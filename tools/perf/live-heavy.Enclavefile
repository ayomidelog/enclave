[sandbox]
name = "heavy-live"
suite = "bookworm"
bootstrap_method = "cached_rootfs"
memory_mb = 768
cpu_percent = 40
max_procs = 256

[workspace.ws01]
name = "ws01"
memory_mb = 64
cpu_percent = 5
max_procs = 32
run = "sh -c 'for i in 1 2 3; do setsid -f yes </dev/null >/dev/null 2>&1; done; exit 0'"
